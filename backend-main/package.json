{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "start": "node src/app.js",
    "dev": "nodemon src/app.js",
    "test": "mocha",
    "test:report": "mocha --timeout 60000 --exit --reporter mochawesome && start mochawesome-report/mochawesome.html",
    "test:coverage": "c8 mocha && start coverage/index.html"
  },
  "c8": {
    "reporter": [
      "text",
      "html",
      "lcov"
    ],
    "include": [
      "src/controllers/**/*.js",
      "src/models/**/*.js",
      "src/middleware/**/*.js",
      "src/routes/**/*.js"
    ],
    "all": true,
    "report-dir": "coverage"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^7.5.0",
    "express-validator": "^7.2.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.6.1",
    "morgan": "^1.10.0",
    "nodemailer": "^8.0.7",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "resend": "^6.12.3",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "c8": "^11.0.0",
    "chai": "^6.2.2",
    "chai-http": "^5.1.2",
    "mocha": "^11.7.5",
    "mochawesome": "^7.1.4",
    "mongodb-memory-server": "^11.1.0",
    "nodemon": "^3.1.14",
    "sinon": "^22.0.0",
    "supertest": "^7.2.2"
  }
}
